<?xml version="1.0" encoding="utf-8"?>

<!-- f.Wave build 3 - file 1 of 4: MainWindow.xaml -->

<Window
    x:Class="f.Wave.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:f.Wave"
    Title="f.Wave">

    <!-- Metro rules used here:
         1. content over chrome: no panels, no borders, no cards
         2. typography is the UI: huge light lowercase headings
         3. flat saturated tiles, zero corner radius
         4. one accent colour per tile, black background
         5. circle-outline icon buttons instead of text buttons -->

    <Grid Background="#FF000000" RequestedTheme="Dark">

        <Grid.Resources>

            <!-- Palette -->
            <SolidColorBrush x:Key="OrangeBrush" Color="#FFFAA602"/>
            <SolidColorBrush x:Key="GreenBrush"  Color="#FF41B657"/>
            <SolidColorBrush x:Key="PinkBrush"   Color="#FFF83887"/>
            <SolidColorBrush x:Key="BlueBrush"   Color="#FF22B9F5"/>
            <SolidColorBrush x:Key="DimBrush"    Color="#FF8A8A8A"/>

            <!-- One font key so you can swap it in one place.
                 To bundle a custom font: ms-appx:///Assets/Fonts/YourFont.ttf#Font Name -->
            <FontFamily x:Key="MetroFont">Segoe UI</FontFamily>

            <!-- Visualizer bar -->
            <Style x:Key="BarStyle" TargetType="Border">
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
            </Style>

            <!-- Flat tile: no rounded corners, no theme hover colours, slight squash on press -->
            <Style x:Key="MetroTileStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource MetroFont}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Bottom"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root"
                                  Background="{TemplateBinding Background}"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="Squash" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.88"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Squash.ScaleX" Value="0.97"/>
                                                <Setter Target="Squash.ScaleY" Value="0.97"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.4"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <ContentPresenter
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Circle outline icon button (the classic Metro app-bar button) -->
            <Style x:Key="MetroCircleButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="68"/>
                <Setter Property="Height" Value="68"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Fill" Value="#33FFFFFF"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Fill" Value="#99FFFFFF"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Opacity" Value="0.35"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Ellipse x:Name="Ring"
                                         Stroke="{TemplateBinding Foreground}"
                                         StrokeThickness="2"
                                         Fill="Transparent"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </Grid.Resources>

        <Grid Margin="36,18,36,24">

            <!-- Pivot gives you the real Metro header/title pattern and the page switching for free -->
            <Pivot>

                <Pivot.Resources>
                    <SolidColorBrush x:Key="PivotHeaderForegroundSelectedBrush"   Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="PivotHeaderForegroundUnselectedBrush" Color="#FF5C5C5C"/>
                </Pivot.Resources>

                <Pivot.Title>
                    <TextBlock Text="F.WAVE  ·  FLAKESOFT"
                               FontFamily="{StaticResource MetroFont}"
                               FontSize="12"
                               CharacterSpacing="200"
                               Foreground="{StaticResource DimBrush}"
                               Margin="12,0,0,6"/>
                </Pivot.Title>

                <Pivot.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontFamily="{StaticResource MetroFont}"
                                   FontSize="40"
                                   FontWeight="Light"/>
                    </DataTemplate>
                </Pivot.HeaderTemplate>

                <!-- ================= HOME ================= -->
                <PivotItem Header="home">
                    <Grid Margin="12,20,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title block -->
                        <StackPanel Grid.Row="0" Spacing="2">
                            <TextBlock Text="listen."
                                       FontFamily="{StaticResource MetroFont}"
                                       FontSize="72"
                                       FontWeight="Light"/>
                            <TextBlock Text="your desktop. your sound."
                                       FontFamily="{StaticResource MetroFont}"
                                       FontSize="16"
                                       Foreground="{StaticResource DimBrush}"/>
                        </StackPanel>

                        <!-- Visualizer: the bars are created in code (MainWindow.xaml.cs) -->
                        <Grid x:Name="BarsHost"
                              Grid.Row="1"
                              MinHeight="160"
                              MaxHeight="260"
                              Margin="0,28,0,20"
                              VerticalAlignment="Bottom"/>

                        <!-- Tiles -->
                        <Grid Grid.Row="2" ColumnSpacing="8" Height="128">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource MetroTileStyle}"
                                    Background="{StaticResource OrangeBrush}"
                                    VerticalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Text="source" FontSize="12" Opacity="0.8"/>
                                    <TextBlock Text="system audio" FontSize="22" FontWeight="Light"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Style="{StaticResource MetroTileStyle}"
                                    Background="{StaticResource GreenBrush}"
                                    VerticalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Text="device" FontSize="12" Opacity="0.8"/>
                                    <TextBlock Text="default output" FontSize="22" FontWeight="Light"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Style="{StaticResource MetroTileStyle}"
                                    Background="{StaticResource PinkBrush}"
                                    VerticalAlignment="Stretch"
                                    Click="OverlayTile_Click">
                                <StackPanel>
                                    <TextBlock Text="screen overlay" FontSize="12" Opacity="0.8"/>
                                    <TextBlock x:Name="OverlayValue" Text="off" FontSize="22" FontWeight="Light"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Action row -->
                        <Grid Grid.Row="3" Margin="0,22,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <Button Style="{StaticResource MetroCircleButtonStyle}"
                                        AutomationProperties.Name="start or stop listening"
                                        Click="ListenButton_Click">
                                    <FontIcon x:Name="ListenIcon" Glyph="&#xE768;" FontSize="24"/>
                                </Button>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ListenLabel"
                                               Text="start listening"
                                               FontFamily="{StaticResource MetroFont}"
                                               FontSize="20"
                                               FontWeight="Light"/>
                                    <TextBlock x:Name="StatusText"
                                               Text="stopped  ·  not capturing"
                                               FontFamily="{StaticResource MetroFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource DimBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="v0.1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       FontFamily="{StaticResource MetroFont}"
                                       FontSize="11"
                                       Foreground="#FF4A4A4A"/>
                        </Grid>
                    </Grid>
                </PivotItem>

                <!-- ================= APPEARANCE ================= -->
                <PivotItem Header="appearance">
                    <StackPanel Margin="12,20,12,0" Spacing="4">
                        <TextBlock Text="look."
                                   FontFamily="{StaticResource MetroFont}"
                                   FontSize="72"
                                   FontWeight="Light"/>
                        <TextBlock Text="colours, bar width, spacing. coming soon."
                                   FontFamily="{StaticResource MetroFont}"
                                   FontSize="16"
                                   Foreground="{StaticResource DimBrush}"/>
                    </StackPanel>
                </PivotItem>

                <!-- ================= EFFECTS ================= -->
                <PivotItem Header="effects">
                    <StackPanel Margin="12,20,12,0" Spacing="4">
                        <TextBlock Text="motion."
                                   FontFamily="{StaticResource MetroFont}"
                                   FontSize="72"
                                   FontWeight="Light"/>
                        <TextBlock Text="smoothing, peak hold, glow. coming soon."
                                   FontFamily="{StaticResource MetroFont}"
                                   FontSize="16"
                                   Foreground="{StaticResource DimBrush}"/>
                    </StackPanel>
                </PivotItem>

                <!-- ================= SETTINGS ================= -->
                <PivotItem Header="settings">
                    <StackPanel Margin="12,20,12,0" Spacing="4">
                        <TextBlock Text="tune."
                                   FontFamily="{StaticResource MetroFont}"
                                   FontSize="72"
                                   FontWeight="Light"/>
                        <TextBlock Text="audio device, startup, about. coming soon."
                                   FontFamily="{StaticResource MetroFont}"
                                   FontSize="16"
                                   Foreground="{StaticResource DimBrush}"/>
                    </StackPanel>
                </PivotItem>

            </Pivot>
        </Grid>

        <!-- Invisible strip so you can still drag the window by the top edge -->
        <Grid x:Name="TitleBarDrag"
              Height="32"
              VerticalAlignment="Top"
              Background="Transparent"/>
    </Grid>
</Window>
