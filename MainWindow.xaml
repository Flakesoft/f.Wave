<?xml version="1.0" encoding="utf-8"?>

<!-- f.Wave build 3 - file 1 of 4: MainWindow.xaml -->

<Window
    x:Class="f.Wave.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:f.Wave"
    Title="f.Wave">

    <!-- Metro / Modern UI Rules:
         1. Clean adaptive canvas (Deep Charcoal for Dark, Luminous Off-White for Light).
         2. Typography is the UI: huge light lowercase headers, uppercase tracking labels.
         3. Flat saturated tiles with snappy feedback and zero radius.
         4. Fully readable contrast in both themes. -->

    <Grid x:Name="RootShell" Background="#FFF4F4F4" RequestedTheme="Light">

        <Grid.Resources>

            <!-- Adaptive Theme Brushes -->
            <SolidColorBrush x:Key="CanvasBackground" Color="#FFF4F4F4"/>
            <SolidColorBrush x:Key="SurfaceBrush"       Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="TextPrimary"      Color="#FF111111"/>
            <SolidColorBrush x:Key="TextSecondary"    Color="#FF666666"/>
            <SolidColorBrush x:Key="BorderSubtle"     Color="#FFD2D2D2"/>

            <!-- Saturated Metro Accents -->
            <SolidColorBrush x:Key="AccentOrange"     Color="#FFFA6800"/>
            <SolidColorBrush x:Key="AccentGreen"      Color="#FF1BA1E2"/>
            <SolidColorBrush x:Key="AccentPink"       Color="#FFE51400"/>

            <FontFamily x:Key="MetroFont">Segoe UI</FontFamily>

            <!-- Visualizer bar -->
            <Style x:Key="BarStyle" TargetType="Border">
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
            </Style>

            <!-- User-Friendly Interactive Command Button -->
            <Style x:Key="MetroCommandStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="52"/>
                <Setter Property="Padding" Value="18,0"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Compact adjuster (+ / -) -->
            <Style x:Key="MetroAdjustStyle" TargetType="Button" BasedOn="{StaticResource MetroCommandStyle}">
                <Setter Property="Width" Value="52"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <!-- Metro Tile Style -->
            <Style x:Key="MetroTileStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource MetroFont}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="20,18"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Bottom"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root"
                                  Background="{TemplateBinding Background}"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="Squash" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.92"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Squash.ScaleX" Value="0.98"/>
                                                <Setter Target="Squash.ScaleY" Value="0.98"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <ContentPresenter
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Circular Icon Button -->
            <Style x:Key="MetroCircleButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="72"/>
                <Setter Property="Height" Value="72"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Fill" Value="#11000000"/>
                                                <Setter Target="Ring.Stroke" Value="{StaticResource AccentOrange}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.Fill" Value="#22000000"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Ellipse x:Name="Ring"
                                         Stroke="{TemplateBinding Foreground}"
                                         StrokeThickness="2"
                                         Fill="{StaticResource SurfaceBrush}"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Form Controls -->
            <Style x:Key="MetroAppearanceComboBoxStyle" TargetType="ComboBox">
                <Setter Property="MinHeight" Value="52"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style x:Key="MetroAppearanceSliderStyle" TargetType="Slider">
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Foreground" Value="{StaticResource AccentOrange}"/>
                <Setter Property="Background" Value="{StaticResource BorderSubtle}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="0"/>
            </Style>

            <Style x:Key="MetroAppearanceToggleStyle" TargetType="ToggleSwitch">
                <Setter Property="MinHeight" Value="52"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="OnContent" Value="on"/>
                <Setter Property="OffContent" Value="off"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

        </Grid.Resources>

        <!-- Main Shell Canvas -->
        <Grid Margin="56,32,56,40" Background="{StaticResource CanvasBackground}">

            <!-- Windows 8 Pivot / Panorama Container -->
            <Pivot x:Name="MainPivot">

                <Pivot.Resources>
                    <SolidColorBrush x:Key="PivotHeaderForegroundSelectedBrush"   Color="#FF111111"/>
                    <SolidColorBrush x:Key="PivotHeaderForegroundUnselectedBrush" Color="#FF999999"/>
                </Pivot.Resources>

                <!-- Subtitle header tag -->
                <Pivot.Title>
                    <TextBlock Text="F.WAVE  ·  FLAKESOFT"
                               FontFamily="{StaticResource MetroFont}"
                               FontSize="11"
                               CharacterSpacing="250"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,12"/>
                </Pivot.Title>

                <!-- Giant lowercase panorama headers -->
                <Pivot.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontFamily="{StaticResource MetroFont}"
                                   FontSize="46"
                                   FontWeight="Light"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </DataTemplate>
                </Pivot.HeaderTemplate>

                <!-- ================= HOME HUB ================= -->
                <PivotItem Header="home">
                    <Grid Margin="0,20,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title block -->
                        <StackPanel Grid.Row="0" Spacing="6">
                            <TextBlock Text="listen."
                                       FontFamily="{StaticResource MetroFont}"
                                       FontSize="80"
                                       FontWeight="Light"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="your desktop. your sound."
                                       FontFamily="{StaticResource MetroFont}"
                                       FontSize="16"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>

                        <!-- Live audio visualizer canvas -->
                        <Grid x:Name="BarsHost"
                              Grid.Row="1"
                              MinHeight="180"
                              MaxHeight="280"
                              Margin="0,32,0,32"
                              VerticalAlignment="Bottom"/>

                        <!-- Metro Live Tiles -->
                        <Grid Grid.Row="2" ColumnSpacing="16" Height="140">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource MetroTileStyle}"
                                    Background="{StaticResource AccentOrange}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="SOURCE" FontSize="11" CharacterSpacing="150" Opacity="0.9"/>
                                    <TextBlock Text="system audio" FontSize="22" FontWeight="Light"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Style="{StaticResource MetroTileStyle}"
                                    Background="{StaticResource AccentGreen}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="DEVICE" FontSize="11" CharacterSpacing="150" Opacity="0.9"/>
                                    <TextBlock Text="default output" FontSize="22" FontWeight="Light"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Style="{StaticResource MetroTileStyle}"
                                    Background="{StaticResource AccentPink}"
                                    Click="OverlayTile_Click">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="SCREEN OVERLAY" FontSize="11" CharacterSpacing="150" Opacity="0.9"/>
                                    <TextBlock x:Name="OverlayValue" Text="off" FontSize="22" FontWeight="Light"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Action Bar Row -->
                        <Grid Grid.Row="3" Margin="0,28,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                                <Button x:Name="PlayButton"
                                        Style="{StaticResource MetroCircleButtonStyle}"
                                        AutomationProperties.Name="start or stop listening"
                                        Click="ListenButton_Click">
                                    <FontIcon x:Name="ListenIcon" Glyph="&#xE768;" FontSize="24" Foreground="{StaticResource TextPrimary}"/>
                                </Button>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ListenLabel"
                                               Text="start listening"
                                               FontFamily="{StaticResource MetroFont}"
                                               FontSize="24"
                                               FontWeight="Light"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock x:Name="StatusText"
                                               Text="stopped  ·  not capturing"
                                               FontFamily="{StaticResource MetroFont}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="v0.1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       FontFamily="{StaticResource MetroFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"/>
                        </Grid>
                    </Grid>
                </PivotItem>

                <!-- ================= APPEARANCE SCREEN ================= -->
                <PivotItem Header="appearance">
                    <ScrollViewer Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="40">
                            <StackPanel Spacing="6">
                                <TextBlock Text="look."
                                           FontFamily="{StaticResource MetroFont}"
                                           FontSize="80"
                                           FontWeight="Light"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="make f.wave yours with clean metro tuning."
                                           FontFamily="{StaticResource MetroFont}"
                                           FontSize="16"
                                           Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <!-- Two-Column Settings Canvas -->
                            <Grid ColumnSpacing="72">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- COLUMN 1: APP INTERFACE SETTINGS -->
                                <StackPanel Grid.Column="0" Spacing="32">
                                    <TextBlock Text="app interface"
                                               FontFamily="{StaticResource MetroFont}"
                                               FontSize="28"
                                               FontWeight="Light"
                                               Foreground="{StaticResource AccentOrange}"/>

                                    <StackPanel Spacing="10">
                                        <TextBlock Text="THEME" FontSize="11" CharacterSpacing="150" Foreground="{StaticResource TextSecondary}"/>
                                        <ComboBox x:Name="ThemeSelector"
                                                  Style="{StaticResource MetroAppearanceComboBoxStyle}"
                                                  SelectedIndex="0"
                                                  SelectionChanged="ThemeSelector_SelectionChanged"
                                                  HorizontalAlignment="Stretch"
                                                  Visibility="Collapsed">
                                            <ComboBoxItem Content="light"/>
                                            <ComboBoxItem Content="dark"/>
                                        </ComboBox>
                                        <Button x:Name="ThemeOptionButton" Style="{StaticResource MetroCommandStyle}" Content="light" Click="ThemeOptionButton_Click"/>
                                    </StackPanel>

                                    <StackPanel Spacing="10">
                                        <TextBlock Text="INTERFACE DENSITY" FontSize="11" CharacterSpacing="150" Foreground="{StaticResource TextSecondary}"/>
                                        <ComboBox x:Name="DensitySelector"
                                                  Style="{StaticResource MetroAppearanceComboBoxStyle}"
                                                  SelectedIndex="0"
                                                  SelectionChanged="DensitySelector_SelectionChanged"
                                                  HorizontalAlignment="Stretch"
                                                  Visibility="Collapsed">
                                            <ComboBoxItem Content="comfortable"/>
                                            <ComboBoxItem Content="compact"/>
                                        </ComboBox>
                                        <Button x:Name="DensityOptionButton" Style="{StaticResource MetroCommandStyle}" Content="comfortable" Click="DensityOptionButton_Click"/>
                                    </StackPanel>

                                    <StackPanel Spacing="10">
                                        <ToggleSwitch x:Name="StatusToggle"
                                                      Style="{StaticResource MetroAppearanceToggleStyle}"
                                                      Header="show status details"
                                                      IsOn="True"
                                                      Toggled="StatusToggle_Toggled"
                                                      Visibility="Collapsed"/>
                                        <Button x:Name="StatusOptionButton" Style="{StaticResource MetroCommandStyle}" Content="show status details · on" Click="StatusOptionButton_Click"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- COLUMN 2: VISUALIZER PERSONALIZATIONS -->
                                <StackPanel Grid.Column="1" Spacing="32">
                                    <TextBlock Text="visualizer personalizations"
                                               FontFamily="{StaticResource MetroFont}"
                                               FontSize="28"
                                               FontWeight="Light"
                                               Foreground="{StaticResource AccentGreen}"/>

                                    <!-- Live Preview Tile Frame -->
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <TextBlock Text="LIVE PREVIEW" FontSize="11" CharacterSpacing="150" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock x:Name="PreviewModeText" Text="smooth movement · on" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                        </Grid>
                                        <Grid Height="104" x:Name="PreviewHost" Background="{StaticResource SurfaceBrush}" VerticalAlignment="Bottom"/>
                                    </StackPanel>

                                    <StackPanel Spacing="10">
                                        <TextBlock Text="COLOUR PALETTE" FontSize="11" CharacterSpacing="150" Foreground="{StaticResource TextSecondary}"/>
                                        <ComboBox x:Name="PaletteSelector"
                                                  Style="{StaticResource MetroAppearanceComboBoxStyle}"
                                                  SelectedIndex="0"
                                                  HorizontalAlignment="Stretch"
                                                  Visibility="Collapsed">
                                            <ComboBoxItem Content="sunset"/>
                                            <ComboBoxItem Content="ocean"/>
                                            <ComboBoxItem Content="mono"/>
                                        </ComboBox>
                                        <Button x:Name="PaletteOptionButton" Style="{StaticResource MetroCommandStyle}" Content="sunset" Click="PaletteOptionButton_Click"/>
                                    </StackPanel>

                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <TextBlock Text="BAR SPACING" FontSize="11" CharacterSpacing="150" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock x:Name="SpacingValue" Text="4 px" HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource MetroAdjustStyle}" Content="−" Click="SpacingDownButton_Click"/>
                                            <Slider Grid.Column="1" x:Name="SpacingSlider"
                                                    Style="{StaticResource MetroAppearanceSliderStyle}"
                                                    Minimum="0" Maximum="12" Value="4" StepFrequency="1" Visibility="Collapsed" Margin="12,0"/>
                                            <Button Grid.Column="2" Style="{StaticResource MetroAdjustStyle}" Content="+" Click="SpacingUpButton_Click"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <TextBlock Text="BAR OPACITY" FontSize="11" CharacterSpacing="150" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock x:Name="OpacityValue" Text="100%" HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource MetroAdjustStyle}" Content="−" Click="OpacityDownButton_Click"/>
                                            <Slider Grid.Column="1" x:Name="OpacitySlider"
                                                    Style="{StaticResource MetroAppearanceSliderStyle}"
                                                    Minimum="20" Maximum="100" Value="100" StepFrequency="5" ValueChanged="OpacitySlider_ValueChanged" Visibility="Collapsed" Margin="12,0"/>
                                            <Button Grid.Column="2" Style="{StaticResource MetroAdjustStyle}" Content="+" Click="OpacityUpButton_Click"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="10">
                                        <ToggleSwitch x:Name="AnimationToggle"
                                                      Style="{StaticResource MetroAppearanceToggleStyle}"
                                                      Header="smooth movement"
                                                      IsOn="True"
                                                      Toggled="AnimationToggle_Toggled"
                                                      Visibility="Collapsed"/>
                                        <Button x:Name="AnimationOptionButton" Style="{StaticResource MetroCommandStyle}" Content="smooth movement · on" Click="AnimationOptionButton_Click"/>
                                    </StackPanel>
                                </StackPanel>

                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>

                <!-- ================= EFFECTS ================= -->
                <PivotItem Header="effects">
                    <StackPanel Margin="0,20,0,0" Spacing="6">
                        <TextBlock Text="motion."
                                   FontFamily="{StaticResource MetroFont}"
                                   FontSize="80"
                                   FontWeight="Light"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="smoothing, peak hold, glow. coming soon."
                                   FontFamily="{StaticResource MetroFont}"
                                   FontSize="16"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </PivotItem>

                <!-- ================= SETTINGS ================= -->
                <PivotItem Header="settings">
                    <StackPanel Margin="0,20,0,0" Spacing="6">
                        <TextBlock Text="tune."
                                   FontFamily="{StaticResource MetroFont}"
                                   FontSize="80"
                                   FontWeight="Light"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="audio device, startup, about. coming soon."
                                   FontFamily="{StaticResource MetroFont}"
                                   FontSize="16"
                                   Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </PivotItem>

            </Pivot>
        </Grid>

        <!-- Invisible top-edge window drag strip -->
        <Grid x:Name="TitleBarDrag"
              Height="36"
              VerticalAlignment="Top"
              Background="Transparent"/>
    </Grid>
</Window>