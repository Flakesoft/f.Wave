<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="f.Wave.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="f.Wave">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="#FFF5F5F5" RequestedTheme="Light">

        <Grid.Resources>
            <!-- Flakesoft palette -->
            <SolidColorBrush x:Key="FlakeOrange" Color="#FAA602"/>
            <SolidColorBrush x:Key="FlakeGreen" Color="#41B657"/>
            <SolidColorBrush x:Key="FlakePink" Color="#F83887"/>
            <SolidColorBrush x:Key="FlakeBlue" Color="#22B9F5"/>

            <!-- Fluent surfaces -->
            <SolidColorBrush x:Key="SidebarBrush" Color="#FFF0F0F0"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#FFE5E5E5"/>
            <SolidColorBrush x:Key="PrimaryText" Color="#FF242424"/>
            <SolidColorBrush x:Key="SecondaryText" Color="#FF666666"/>
            <SolidColorBrush x:Key="TertiaryText" Color="#FF888888"/>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border
            Grid.Column="0"
            Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="65"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel
                    Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="11"
                    VerticalAlignment="Center"
                    Margin="22,0">

                    <Border
                        Width="34"
                        Height="34"
                        Background="{StaticResource FlakeOrange}"
                        CornerRadius="8">

                        <FontIcon
                            Glyph="&#xE768;"
                            FontSize="19"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock
                        Text="f.Wave"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryText}"
                        VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel
                    Grid.Row="1"
                    Spacing="5"
                    Margin="12,15,12,0">

                    <Border
                        Background="#FFFFEFCB"
                        CornerRadius="5"
                        Padding="11,10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="27"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Glyph="&#xE80F;"
                                FontSize="17"
                                Foreground="#FF8A5900"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="Overview"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryText}"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Button
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="11,10"
                        HorizontalContentAlignment="Stretch">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="27"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Glyph="&#xE790;"
                                FontSize="17"
                                Foreground="{StaticResource SecondaryText}"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="Appearance"
                                FontSize="14"
                                Foreground="{StaticResource PrimaryText}"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="11,10"
                        HorizontalContentAlignment="Stretch">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="27"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Glyph="&#xE9E9;"
                                FontSize="17"
                                Foreground="{StaticResource SecondaryText}"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="Effects"
                                FontSize="14"
                                Foreground="{StaticResource PrimaryText}"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                </StackPanel>

                <!-- Settings -->
                <Button
                    Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    Margin="12,0"
                    Padding="11,10"
                    HorizontalContentAlignment="Stretch">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="27"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Glyph="&#xE713;"
                            FontSize="17"
                            Foreground="{StaticResource SecondaryText}"
                            VerticalAlignment="Center"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="Settings"
                            FontSize="14"
                            Foreground="{StaticResource PrimaryText}"
                            VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid
            Grid.Column="1"
            Margin="36,30,36,25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid
                Grid.Row="0"
                Margin="0,0,0,27">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock
                        Text="OVERVIEW"
                        FontSize="11"
                        FontWeight="SemiBold"
                        CharacterSpacing="100"
                        Foreground="{StaticResource TertiaryText}"/>

                    <TextBlock
                        Text="Overview"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryText}"/>
                </StackPanel>

                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="11,9">

                    <FontIcon
                        Glyph="&#xE713;"
                        FontSize="17"
                        Foreground="{StaticResource SecondaryText}"/>
                </Button>
            </Grid>

            <!-- Main area -->
            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Visualization -->
                <Border
                    Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    Margin="0,0,18,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock
                                Text="Visualization"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryText}"/>

                            <TextBlock
                                Text="PREVIEW"
                                HorizontalAlignment="Right"
                                FontSize="10"
                                FontWeight="SemiBold"
                                CharacterSpacing="80"
                                Foreground="{StaticResource TertiaryText}"/>
                        </Grid>

                        <!-- Preview bars -->
                        <Grid
                            Grid.Row="1"
                            Margin="5,20,5,20">

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="7"
                                Height="170">

                                <Border Width="6" Height="35"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakeOrange}"
                                    VerticalAlignment="Bottom"/>

                                <Border Width="6" Height="57"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakeOrange}"
                                    VerticalAlignment="Bottom"/>

                                <Border Width="6" Height="88"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakeGreen}"
                                    VerticalAlignment="Bottom"/>

                                <Border Width="6" Height="49"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakeGreen}"
                                    VerticalAlignment="Bottom"/>

                                <Border Width="6" Height="115"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakePink}"
                                    VerticalAlignment="Bottom"/>

                                <Border Width="6" Height="145"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakePink}"
                                    VerticalAlignment="Bottom"/>

                                <Border Width="6" Height="78"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakeBlue}"
                                    VerticalAlignment="Bottom"/>

                                <Border Width="6" Height="53"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakeBlue}"
                                    VerticalAlignment="Bottom"/>

                                <Border Width="6" Height="125"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakeOrange}"
                                    VerticalAlignment="Bottom"/>

                                <Border Width="6" Height="158"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakeOrange}"
                                    VerticalAlignment="Bottom"/>

                                <Border Width="6" Height="92"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakeGreen}"
                                    VerticalAlignment="Bottom"/>

                                <Border Width="6" Height="64"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakeGreen}"
                                    VerticalAlignment="Bottom"/>

                                <Border Width="6" Height="132"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakePink}"
                                    VerticalAlignment="Bottom"/>

                                <Border Width="6" Height="85"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakePink}"
                                    VerticalAlignment="Bottom"/>

                                <Border Width="6" Height="46"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakeBlue}"
                                    VerticalAlignment="Bottom"/>

                                <Border Width="6" Height="110"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakeBlue}"
                                    VerticalAlignment="Bottom"/>

                                <Border Width="6" Height="72"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakeOrange}"
                                    VerticalAlignment="Bottom"/>

                                <Border Width="6" Height="42"
                                    CornerRadius="3"
                                    Background="{StaticResource FlakeOrange}"
                                    VerticalAlignment="Bottom"/>

                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Fill="{StaticResource FlakeGreen}"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Text="Waiting for system audio"
                                    FontSize="12"
                                    Foreground="{StaticResource SecondaryText}"/>
                            </StackPanel>

                            <TextBlock
                                Text="INACTIVE"
                                HorizontalAlignment="Right"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TertiaryText}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Controls -->
                <StackPanel
                    Grid.Column="1"
                    Spacing="20">

                    <StackPanel Spacing="5">
                        <TextBlock
                            Text="System audio"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryText}"/>

                        <TextBlock
                            Text="Audio capture status"
                            FontSize="12"
                            Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>

                    <Border
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="17">

                        <StackPanel Spacing="13">

                            <TextBlock
                                Text="Audio source"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryText}"/>

                            <TextBlock
                                Text="Default system output"
                                FontSize="12"
                                Foreground="{StaticResource SecondaryText}"/>

                            

                            <TextBlock
                                Text="No active audio capture"
                                FontSize="12"
                                Foreground="{StaticResource TertiaryText}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="10">
                        <TextBlock
                            Text="Visualization"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryText}"/>

                        <Button
                            HorizontalAlignment="Stretch"
                            Background="{StaticResource FlakeOrange}"
                            Foreground="#FF242424"
                            BorderThickness="0"
                            Padding="14,11"
                            FontWeight="SemiBold"
                            Content="Start visualization"
                            IsEnabled="False"/>

                        <TextBlock
                            Text="Audio capture is not connected yet."
                            TextWrapping="Wrap"
                            FontSize="11"
                            Foreground="{StaticResource SecondaryText}"/>
                    </StackPanel>

                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Grid
                Grid.Row="2"
                Margin="0,20,0,0">

                <TextBlock
                    Text="f.Wave"
                    FontSize="12"
                    Foreground="{StaticResource SecondaryText}"/>

                <TextBlock
                    Text="The New Flakesoft"
                    FontSize="12"
                    Foreground="{StaticResource TertiaryText}"
                    HorizontalAlignment="Right"/>
            </Grid>

        </Grid>
    </Grid>
</Window>
